# Copy to agent/.env and fill in. Never commit the filled-in file.
# Common LIVEKIT_URL/LIVEKIT_API_KEY/LIVEKIT_API_SECRET and
# LAUNCHPAD_AGENT_SECRET load from ../.env.local. Do not duplicate them here.
SYNTHESIA_API_KEY=
# Copy Interactive ID from an eligible avatar in your Synthesia workspace.
SYNTHESIA_AVATAR_ID=
OPENAI_API_KEY=
# Models used by the current official minimal quickstart; usage is billable.
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
LIVEKIT_STT_MODEL=cartesia/ink-2
LIVEKIT_TTS_MODEL=cartesia/sonic-3.6
CARTESIA_VOICE_ID=a167e0f3-df7e-4d52-a9c3-f949145efdab
# Local worker health port.
LAUNCHPAD_AGENT_PORT=8783
LAUNCHPAD_APP_ORIGIN=http://127.0.0.1:3212
